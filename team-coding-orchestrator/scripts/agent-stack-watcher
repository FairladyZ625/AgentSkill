#!/usr/bin/env bash
# agent-stack-watcher: poll tmux pane until agent finishes, then fire Discord webhook
# Usage: agent-stack-watcher <bot_id> <agent> <pane_target> <task_desc> [task_token]
# Designed to run detached via nohup

set -uo pipefail

BOT_ID="${1:?bot_id required}"
AGENT="${2:?agent required}"
PANE_TARGET="${3:?pane_target required}"
TASK_DESC="${4:-task}"
TASK_TOKEN="${5:-}"

SESSION_NAME="agent-stack"
WINDOW_NAME="orchestrator"
ENV_FILE="${AGENT_STACK_ENV:-$HOME/.config/agent-stack/env.sh}"
POLL_INTERVAL=10
MAX_WAIT=7200

# Load env for webhook URL
if [[ -f "$ENV_FILE" ]]; then
  source "$ENV_FILE"
fi

if [[ -z "${DISCORD_WEBHOOK_URL:-}" ]]; then
  echo "DISCORD_WEBHOOK_URL not set, exiting"
  exit 1
fi

send_webhook() {
  local emoji="$1" status_text="$2" detail="$3"
  local message="${emoji} ${AGENT} ${status_text}: ${detail} <@${BOT_ID}>"
  curl -s -X POST "$DISCORD_WEBHOOK_URL" \
    -H "Content-Type: application/json" \
    -d "{\"content\":$(printf '%s' "$message" | jq -Rs .)}" \
    >/dev/null 2>&1
  echo "[notify] sent: $message"
}

# Wait for process to start
sleep 5

elapsed=0
while (( elapsed < MAX_WAIT )); do
  # Check session exists
  if ! tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    echo "tmux session gone, exiting"
    exit 1
  fi

  # Get current command in the pane
  cur_cmd="$(tmux list-panes -t "${SESSION_NAME}:${WINDOW_NAME}" \
    -F '#{pane_id}|#{pane_current_command}' 2>/dev/null \
    | grep "^${PANE_TARGET}|" | cut -d'|' -f2)"

  # Preferred completion path: detect explicit marker with exit code
  if [[ -n "$TASK_TOKEN" ]]; then
    marker_line="$(tmux capture-pane -t "$PANE_TARGET" -p -S -120 2>/dev/null       | grep "__AGENT_STACK_DONE__:${TASK_TOKEN}:"       | grep -v 'echo "__AGENT_STACK_DONE__'       | tail -n 1 || true)"
    if [[ -n "$marker_line" ]]; then
      # strip possible surrounding quotes/spaces
      marker_line="$(printf '%s' "$marker_line" | sed 's/^"//; s/"$//')"
      exit_code="${marker_line##*:}"
      if [[ "$exit_code" == "0" ]]; then
        send_webhook "✅" "完成 (${elapsed}s)" "$TASK_DESC"
        exit 0
      else
        send_webhook "❌" "失败 (${elapsed}s, exit=${exit_code})" "$TASK_DESC"
        exit 1
      fi
    fi
  fi

  # Fallback: pane returns to bash
  if [[ "$cur_cmd" == "bash" ]]; then
    send_webhook "✅" "完成 (${elapsed}s)" "$TASK_DESC"
    exit 0
  fi

  sleep "$POLL_INTERVAL"
  (( elapsed += POLL_INTERVAL ))
done

# Timeout
send_webhook "⏰" "超时 (>${MAX_WAIT}s)" "$TASK_DESC"
exit 1
